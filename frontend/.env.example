# Where the Vite dev/preview server forwards /api requests (the HMS backend).
BACKEND_URL=http://localhost:5000

# Which ABDM environment ABHA calls use: SANDBOX (default) or PRODUCTION.
VITE_ABDM_ENVIRONMENT=SANDBOX

# Leave unset to call the API on this app's own origin (proxied to BACKEND_URL).
# Only set it if the frontend is hosted on a different origin than the API; the
# backend's cors() must then allow that origin with credentials.
# VITE_API_URL=https://api.example.com/api
# Set to true in development only if you wish to bypass the login screen for UI preview.
# Always false/disabled in production.
VITE_LOGIN_DISABLED_FOR_PREVIEW=false
