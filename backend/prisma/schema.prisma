// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User{
  id String @id @default(uuid())
  name String
  email String @unique
  passwordHash String 
  facilityId String
  facility Facility @relation(fields: [facilityId], references: [id])
  refreshTokens UserRefreshToken[]
  // What this login may do. Everyone who existed before roles were introduced is an admin, as they effectively were.
  role StaffRole @default(admin)
  // An inactive login cannot sign in and is refused on role-protected routes.
  active Boolean @default(true)
  staff Staff?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum StaffRole {
  front_office
  doctor
  nurse
  pharmacist
  biller
  housekeeping
  lab
  admin
}

enum EmploymentType {
  salaried
  visiting_fee
}

// A member of staff. Not everyone has a login (a visiting doctor may be listed without one): userId is set when they do.
// `role` here is the one the hospital sees; when a login exists the same role is kept on the User (see staff.service.ts).
model Staff {
  id         String @id @default(uuid())
  facilityId String
  userId     String? @unique

  name       String
  role       StaffRole
  department String

  // Health Professional Registry id (ABDM)
  hprId      String?

  employmentType  EmploymentType @default(salaried)
  monthlySalary   Decimal? @db.Decimal(12, 2)
  feePerConsult   Decimal? @db.Decimal(12, 2)
  // What a patient pays to see this doctor, when set for this doctor
  consultationFee Decimal? @db.Decimal(12, 2)
  // Only the last four digits are ever stored
  bankAccountLast4 String?
  dateOfJoining   DateTime @default(now()) @db.Date
  active          Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])

  @@index([facilityId, role])
}

// The hospital's own settings (fees, GSTIN, print text ...). Only values that were changed are stored.
model HospitalSetting {
  facilityId String
  key        String
  value      String
  updatedAt  DateTime @updatedAt

  @@id([facilityId, key])
}

// Append-only record of changes for the whole hospital (NABH / ABDM audit readiness). ABHA actions also have their own
// metadata-only trail in AbhaAuditLog.
model AuditLog {
  id         String   @id @default(uuid())
  facilityId String
  at         DateTime @default(now())
  actor      String
  action     String
  detail     String   @default("")

  @@index([facilityId, at])
}

// occupied (patient in bed) -> dirty (just vacated) -> cleaning (housekeeping started) -> vacant (ready).
// A vacant bed can be reserved for a patient who is coming; it is then not available to anyone else.
enum BedStatus {
  occupied
  dirty
  cleaning
  vacant
  reserved
}

model Bed {
  id         String @id @default(uuid())
  facilityId String

  ward  String
  bedNo String

  status      BedStatus @default(vacant)
  statusSince DateTime  @default(now())

  // Who is in the bed, and under which visit (the visit's own table arrives with the visits stage: plain id for now)
  patientId   String?
  encounterId String?

  // Who a reserved bed is being kept for (a registered patient, or just a name), until when, and why
  reservedPatientId String?
  reservedFor       String?
  reservedUntil     DateTime?
  reservedNote      String?

  facility        Facility @relation(fields: [facilityId], references: [id])
  patient         Patient? @relation("BedOccupant", fields: [patientId], references: [id], onDelete: SetNull)
  reservedPatient Patient? @relation("BedReservation", fields: [reservedPatientId], references: [id], onDelete: SetNull)
  housekeeping    HousekeepingLog[]

  @@unique([facilityId, ward, bedNo])
  @@index([facilityId, status])
}

enum HousekeepingAction {
  discharge_release
  cleaning_started
  cleaning_completed
}

// One line of bed-turnover history (patient left, cleaning started, cleaning done)
model HousekeepingLog {
  id         String             @id @default(uuid())
  facilityId String
  bedId      String
  action     HousekeepingAction
  at         DateTime           @default(now())
  by         String

  bed Bed @relation(fields: [bedId], references: [id], onDelete: Cascade)

  @@index([facilityId, at])
}

// Per-hospital running numbers (MRN, bill numbers ...): `value` is the last number issued.
model FacilityCounter {
  facilityId String
  key        String
  value      Int

  @@id([facilityId, key])
}
model UserRefreshToken {
  id         String   @id @default(cuid())
  tokenHash  String
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Facility {
  id           String   @id @default(cuid())
  name         String
  hfrId        String   @unique
  email        String   @unique
  passwordHash String

  patients     Patient[]
  users        User[]
  abdmData       FacilityAbdmData[]
  refreshTokens FacilityRefreshToken[]
  abhaTransactions AbhaTransaction[]
  patientShares    PatientShare[]
  staff            Staff[]
  beds             Bed[]

  // Facility profile (the HFR id above is the registry id; the HIP id is what the gateway calls this facility)
  hipId        String?
  facilityType String?
  address      String?
  state        String?
  district     String?
  pincode      String?
  phone        String?
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
model FacilityRefreshToken {
  id         String   @id @default(cuid())
  tokenHash  String
  facilityId String   
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  facility Facility @relation(fields: [facilityId], references: [id])

  @@index([facilityId])
}
model FacilityAbdmData {
  id           String   @id @default(cuid())
  facilityId   String   
  clientId     String
  clientSecret String
  environment  AbdmEnvironment
  facility     Facility @relation(fields: [facilityId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([facilityId, environment])
 
}

enum AbdmEnvironment {
  SANDBOX
  PRODUCTION
}


model Patient {

    id String @id @default(uuid())

    name String
    phone String
    email String?

    // Compared with the ABHA profile before an ABHA can be linked (see abhaMatch.ts)
    dateOfBirth DateTime? @db.Date

    // Filled from the ABHA profile when an ABHA is linked (only where empty); editable by staff except name/DOB/gender
    gender       String?
    address      String?
    stateName    String?
    districtName String?

    facilityId String

    // Medical record number, unique within the hospital ("MRN-10001"); issued from FacilityCounter
    mrn String?
    allergies   String[] @default([])
    problemList String[] @default([])

    facility Facility @relation(fields: [facilityId], references: [id])

    abha AbhaPatient?
    abhaTransactions AbhaTransaction[]
    bedsOccupied Bed[] @relation("BedOccupant")
    bedsReserved Bed[] @relation("BedReservation")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([facilityId])
    @@index([phone])
    @@unique([facilityId, mrn])
}

model AbhaPatient {
  id String @id @default(uuid())

  patientId String @unique

  abhaNumber String @unique
  abhaAddress String?

  patient Patient @relation(fields: [patientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model AbhaTransaction {
  id String @id @default(uuid())

  txnId String @unique

  patientId String
  facilityId String

  purpose AbhaTransactionPurpose
  status AbhaTransactionStatus

  expiresAt DateTime

  // Consent shown to and accepted by the patient (set when the OTP is requested; for enrolment it is
  // also the artifact sent to ABDM)
  consentCode       String?
  consentVersion    String?
  consentAcceptedAt DateTime?

  // Language the consent was shown in ("en" or "hi")
  consentLanguage   String?

  // Enrolment follow-ups (mobile verification, ABHA address) continue on ABDM's enrolment txnId
  enrolTxnId        String?
  mobileOtpTxnId    String?
  mobileVerified    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
  facility Facility @relation(fields: [facilityId], references: [id])

  @@index([patientId])
  @@index([facilityId])
}

enum AbhaTransactionPurpose {
  ENROLLMENT
  VERIFICATION
  PROFILE_UPDATE
}

enum AbhaTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

// Who did what in the ABHA module (NHA asks for a complete audit trail). Metadata only:
// never Aadhaar/mobile numbers, OTPs, tokens or profile data.
model AbhaAuditLog {
  id String @id @default(uuid())

  facilityId String
  userId     String?
  patientId  String?
  // our AbhaTransaction.id when the request carried one
  transactionId String?

  action     String
  outcome    String
  httpStatus Int
  errorCode  String?

  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([facilityId, createdAt])
  @@index([patientId])
}

// A profile a person shared by scanning a counter QR code (Scan & Share). It waits here, for at most the token's
// 30-minute validity, until staff register the patient or dismiss it; then it is deleted. These rows are personal
// data, so expired ones are purged (see share.service.ts) and nothing from them is written to logs.
model PatientShare {
  id String @id @default(uuid())

  facilityId  String
  environment AbdmEnvironment

  // Counter from the QR code, and the token handed back to the patient for that counter's queue
  counterCode String
  tokenNumber Int

  // REQUEST-ID of the inbound share: ABDM retries carry the same one and are ignored
  requestId String @unique

  abhaNumber  String?
  abhaAddress String
  name        String
  gender      String?
  dayOfBirth   Int?
  monthOfBirth Int?
  yearOfBirth  Int
  addressLine String?
  district    String?
  state       String?
  pincode     String?
  phone       String?

  // Set when this ABHA is already linked to a patient of the facility
  matchedPatientId String?

  receivedAt DateTime @default(now())
  expiresAt  DateTime

  facility Facility @relation(fields: [facilityId], references: [id])

  @@index([facilityId, expiresAt])
  @@index([facilityId, counterCode, abhaAddress])
}

// Last token handed out per counter per day, so numbers stay sequential and are never reused when shares are deleted
model ShareTokenCounter {
  facilityId  String
  counterCode String
  tokenDate   DateTime @db.Date
  lastToken   Int

  @@id([facilityId, counterCode, tokenDate])
}