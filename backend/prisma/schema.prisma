// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User{
  id String @id @default(uuid())
  name String
  email String @unique
  passwordHash String 
  facilityId String
  facility Facility @relation(fields: [facilityId], references: [id])
  refreshTokens UserRefreshToken[]
  // role 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// enum userRole{
//   ADMIN
//   RECEPTIONIST
//   DOCTOR
// }
model UserRefreshToken {
  id         String   @id @default(cuid())
  tokenHash  String
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Facility {
  id           String   @id @default(cuid())
  name         String
  hfrId        String   @unique
  email        String   @unique
  passwordHash String

  patients     Patient[]
  users        User[]
  abdmData       FacilityAbdmData[]
  refreshTokens FacilityRefreshToken[]
  abhaTransactions AbhaTransaction[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
model FacilityRefreshToken {
  id         String   @id @default(cuid())
  tokenHash  String
  facilityId String   
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  facility Facility @relation(fields: [facilityId], references: [id])

  @@index([facilityId])
}
model FacilityAbdmData {
  id           String   @id @default(cuid())
  facilityId   String   
  clientId     String
  clientSecret String
  environment  AbdmEnvironment
  facility     Facility @relation(fields: [facilityId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([facilityId, environment])
 
}

enum AbdmEnvironment {
  SANDBOX
  PRODUCTION
}


model Patient {

    id String @id @default(uuid())

    name String
    phone String
    email String?

    // Compared with the ABHA profile before an ABHA can be linked (see abhaMatch.ts)
    dateOfBirth DateTime? @db.Date

    // Filled from the ABHA profile when an ABHA is linked (only where empty); editable by staff except name/DOB/gender
    gender       String?
    address      String?
    stateName    String?
    districtName String?

    facilityId String

    facility Facility @relation(fields: [facilityId], references: [id])

    abha AbhaPatient?
    abhaTransactions AbhaTransaction[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([facilityId])
    @@index([phone])
}

model AbhaPatient {
  id String @id @default(uuid())

  patientId String @unique

  abhaNumber String @unique
  abhaAddress String?

  patient Patient @relation(fields: [patientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model AbhaTransaction {
  id String @id @default(uuid())

  txnId String @unique

  patientId String
  facilityId String

  purpose AbhaTransactionPurpose
  status AbhaTransactionStatus

  expiresAt DateTime

  // Consent shown to and accepted by the patient (set when the OTP is requested; for enrolment it is
  // also the artifact sent to ABDM)
  consentCode       String?
  consentVersion    String?
  consentAcceptedAt DateTime?

  // Language the consent was shown in ("en" or "hi")
  consentLanguage   String?

  // Enrolment follow-ups (mobile verification, ABHA address) continue on ABDM's enrolment txnId
  enrolTxnId        String?
  mobileOtpTxnId    String?
  mobileVerified    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
  facility Facility @relation(fields: [facilityId], references: [id])

  @@index([patientId])
  @@index([facilityId])
}

enum AbhaTransactionPurpose {
  ENROLLMENT
  VERIFICATION
  PROFILE_UPDATE
}

enum AbhaTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

// Who did what in the ABHA module (NHA asks for a complete audit trail). Metadata only:
// never Aadhaar/mobile numbers, OTPs, tokens or profile data.
model AbhaAuditLog {
  id String @id @default(uuid())

  facilityId String
  userId     String?
  patientId  String?
  // our AbhaTransaction.id when the request carried one
  transactionId String?

  action     String
  outcome    String
  httpStatus Int
  errorCode  String?

  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([facilityId, createdAt])
  @@index([patientId])
}