PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/hms

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
FACILITY_ACCESS_TOKEN_SECRET=
FACILITY_REFRESH_TOKEN_SECRET=
USER_ACCESS_TOKEN_SECRET=
USER_REFRESH_TOKEN_SECRET=

# 32-byte key (64 hex chars) used to encrypt ABDM client secrets at rest (AES-256-GCM)
ABDM_ENCRYPTION_KEY=

# ABDM gateway session endpoints
SANDBOX_SESSION_URL=https://dev.abdm.gov.in/gateway/v0.5/sessions
PROD_SESSION_URL=https://hiecm.abdm.gov.in/gateway/v0.5/sessions

# Set true while running NHA sandbox test cases to log request metadata
# (REQUEST-ID, TIMESTAMP, X-CM-ID, URL, status) as evidence. Never logs bodies or tokens.
ABDM_AUDIT_LOG=false
